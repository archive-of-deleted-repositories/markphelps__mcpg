#!/bin/sh

echo "Running pre-commit hooks..."

# Auto-format
echo "Formatting code..."
cargo fmt
echo "✓ Formatted"

# Clippy with auto-fix
echo "Running clippy..."
cargo clippy --fix --allow-dirty --allow-staged -- -D warnings
if [ $? -ne 0 ]; then
    echo "❌ Clippy found issues that couldn't be auto-fixed."
    exit 1
fi
echo "✓ Clippy OK"

# Re-add any files modified by fmt or clippy
git add -u

echo "✓ Pre-commit hooks passed!"
